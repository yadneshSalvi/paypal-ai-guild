DATABASE_URL=postgresql://guild:replace_me@localhost:5432/guild
AUTH_SECRET=replace_with_a_unique_random_secret
JUDGE_SESSION_SECRET=replace_with_another_unique_random_secret
# Optional isolated cookie name; default guild_session. Issuer and authority stay unchanged.
GUILD_SESSION_COOKIE=guild_session
CRON_SECRET=replace_with_a_unique_worker_secret
OPENAI_API_KEY=replace_me
OPENAI_MODEL=gpt-6.1-sol
OPENAI_PLANNER_MODEL=gpt-6-astra
# Fail closed on the frozen whisper-1 timestamp capability when held unavailable.
GUILD_DISABLE_WHISPER_TIMESTAMPS=false
GEMINI_API_KEY=replace_me
GEMINI_MODEL=gemini-3.8-flash
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_PROJECT_ISOLATED=true
PAYPAL_CLIENT_ID=replace_with_isolated_sandbox_app_id
PAYPAL_CLIENT_SECRET=replace_with_isolated_sandbox_app_secret
BLOB_READ_WRITE_TOKEN=replace_with_private_blob_token

# Checkout, registered webhook and controlled payout configuration. Keep secrets server-side.
# Hosted checkout fails closed until APP_URL is the exact canonical HTTPS origin.
APP_URL=http://localhost:4101
PAYPAL_API_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_WEBHOOK_ID=
GUILD_SANDBOX_PROVIDER_RECEIVERS_JSON=[]
# Registry entries use providerIndex (1-6), email and controlledSandboxAccount: true.
# Never put the real registry or payment credentials in public files or browser configuration.

# Remaining media and scheduling integrations.
DEEPGRAM_API_KEY=
AG_STUDIO_LICENSE_KEY=
BRYNTUM_LICENSE_KEY=
CHANNEL3_API_KEY=
CHANNEL3_API_BASE_URL=
CHANNEL3_HACKATHON_PROMO_CODE=
DEMO_MODE=live

# Exactly one server-selected runtime: an absolute qualified local/hosted JSON
# file, or the bounded HMAC-sealed hosted JSON. These are never browser inputs.
GUILD_WEB_AUDIT_RUNTIME=
GUILD_WEB_AUDIT_HOSTED_RUNTIME_JSON=
# Local mode only. Hosted evidence is durably retained in PostgreSQL.
GUILD_WEB_AUDIT_EVIDENCE_DIR=
# Prefer the hosting project's OIDC context. Optional explicit server-only token;
# team/project scope and original snapshot identities belong in the sealed JSON.
GUILD_WEB_SANDBOX_TOKEN=

# Explicitly enable only after reviewing the separate Deepgram review agreement.
# This flag cannot replace the current signed Passport or human listening review.
GUILD_ENABLE_DEEPGRAM_REVIEW=false
